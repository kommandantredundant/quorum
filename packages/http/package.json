{
  "name": "quorum-http",
  "version": "0.1.0",
  "description": "Route handler for quorum on web-standard Request/Response, plus a Node http adapter. Matches the routes quorum-ui expects.",
  "license": "MPL-2.0",
  "author": "kommandantredundant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kommandantredundant/quorum.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/kommandantredundant/quorum#readme",
  "bugs": {
    "url": "https://github.com/kommandantredundant/quorum/issues"
  },
  "keywords": [
    "quorum",
    "http",
    "request-response",
    "handler",
    "voting",
    "reputation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "dependencies": {
    "quorum-core": "^0.1.0"
  },
  "scripts": {
    "prepublishOnly": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  }
}
