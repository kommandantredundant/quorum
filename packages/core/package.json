  "description": "Reputation-weighted voting core: weights, evaluation, lifecycle. No I/O, no framework.",
  "license": "MPL-2.0",
  "author": "kommandantredundant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kommandantredundant/quorum.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kommandantredundant/quorum#readme",
  "bugs": {
    "url": "https://github.com/kommandantredundant/quorum/issues"
  },
  "keywords": [
    "quorum",
    "reputation",
    "voting",
    "moderation",
    "community",
    "weighted-voting",
    "crowdsourcing"
