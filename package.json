{
  "name": "quorum",
  "private": true,
  "version": "0.1.1",
  "description": "Embeddable, service-free reputation-weighted voting building block",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "sim": "node packages/sim/dist/cli.js",
    "sweep": "node packages/sim/dist/sweep.js",
    "bundle": "npm run bundle -w quorum-ui",
    "example:minimal": "node examples/minimal/server.mjs",
    "example:moderation": "node examples/with-moderation/server.mjs",
    "release:check": "npm run clean && npm run build && npm run bundle && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MPL-2.0"
}
